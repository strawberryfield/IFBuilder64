<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Casasoft.IFBuilder64.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Casasoft.IFBuilder64.$(MSBuildProjectName)</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0-pre.5" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Common\Common.csproj" />
		<ProjectReference Include="..\Builder\Builder.csproj" />
		<ProjectReference Include="..\Editor\Editor.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Dati\**\*" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Riferimenti\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
