<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Casasoft.IFBuilder64.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Casasoft.IFBuilder64.$(MSBuildProjectName)</RootNamespace>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Builder\Builder.csproj" />
		<ProjectReference Include="..\Common\Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Risorse\Testi.resx">
			<Generator>MSBuild:Compile</Generator>
			<StronglyTypedFileName>Risorse\Testi.Designer.cs</StronglyTypedFileName>
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>Casasoft.IFBuilder64.Editor.Risorse</StronglyTypedNamespace>
			<StronglyTypedClassName>Testi</StronglyTypedClassName>
			<PublicClass>true</PublicClass>
		</EmbeddedResource>
		<Compile Update="Risorse\Testi.Designer.cs" DependentUpon="Testi.resx" AutoGen="True" DesignTime="True" />
	</ItemGroup>

	<!--
		La classe Testi viene rigenerata a ogni build dentro Risorse/ (e versionata) cosi'
		che anche gli strumenti design-time (estensione Avalonia di Visual Studio, IntelliSense)
		la vedano senza una build. GenerateResource aggiunge il file a Compile, ma e' gia'
		incluso dal glob del progetto: qui si elimina il doppione.
	-->
	<Target Name="RimuoviDoppioneTesti" AfterTargets="CoreResGen">
		<ItemGroup>
			<Compile Remove="Risorse\Testi.Designer.cs" />
			<Compile Include="Risorse\Testi.Designer.cs" />
		</ItemGroup>
	</Target>

</Project>
