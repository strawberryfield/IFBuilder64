<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="using:Casasoft.IFBuilder64.Editor.Risorse"
        x:Class="Casasoft.IFBuilder64.Editor.Views.InformazioniWindow"
        Title="{x:Static r:Testi.Informazioni_Titolo}"
        Width="560" Height="460" CanResize="True"
        WindowStartupLocation="CenterOwner">
	<DockPanel Margin="16">
		<Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0"
		        Content="{x:Static r:Testi.Pulsante_Ok}" IsDefault="True" IsCancel="True" Click="Chiudi_Click" />
		<StackPanel DockPanel.Dock="Top" Spacing="4">
			<TextBlock Text="{x:Static r:Testi.Informazioni_Prodotto}" FontSize="20" FontWeight="Bold" />
			<TextBlock x:Name="TestoVersione" />
			<TextBlock Text="{x:Static r:Testi.Informazioni_Licenza}" />
		</StackPanel>
		<StackPanel x:Name="SezioneTerzeParti" DockPanel.Dock="Top" Margin="0,12,0,0" Spacing="4">
			<TextBlock Text="{x:Static r:Testi.Informazioni_Terze}" FontWeight="Bold" />
		</StackPanel>
		<TextBox x:Name="TestoTerzeParti" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,0" />
	</DockPanel>
</Window>
