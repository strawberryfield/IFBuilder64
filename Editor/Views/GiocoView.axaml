<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Casasoft.IFBuilder64.Editor.ViewModels"
             xmlns:v="using:Casasoft.IFBuilder64.Editor.Views"
             xmlns:r="using:Casasoft.IFBuilder64.Editor.Risorse"
             x:Class="Casasoft.IFBuilder64.Editor.Views.GiocoView"
             x:DataType="vm:DocumentoViewModel">
	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8" Spacing="8" MaxWidth="720">
			<TextBlock Text="{x:Static r:Testi.Gioco_Intro}" FontWeight="Bold" />
			<TextBox x:Name="TestoIntro" Text="{Binding Intro, Mode=TwoWay, Converter={x:Static v:ConvertitoriGioco.ACapo}}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />

			<TextBlock Text="{x:Static r:Testi.Gioco_CaricoMassimo}" FontWeight="Bold" />
			<NumericUpDown x:Name="CaricoMassimo" HorizontalAlignment="Left" Width="140"
			               Minimum="0" Maximum="255" Increment="1" FormatString="0"
			               ParsingNumberStyle="Integer"
			               Value="{Binding CaricoMassimo, Mode=TwoWay, Converter={x:Static v:ConvertitoriGioco.ByteDecimale}}" />

			<TextBlock Text="{x:Static r:Testi.Gioco_Direzioni}" FontWeight="Bold" />
			<ItemsControl x:Name="ElencoDirezioni" ItemsSource="{Binding Direzioni}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:MessaggioViewModel">
						<Grid ColumnDefinitions="120,*" Margin="0,2">
							<TextBlock Grid.Column="0" VerticalAlignment="Center"
							           Text="{Binding Indice, Converter={x:Static v:ConvertitoriGioco.NomeDirezione}}" />
							<TextBox Grid.Column="1" Text="{Binding Testo, Mode=TwoWay}" />
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<TextBlock Text="{x:Static r:Testi.Gioco_IFiction}" FontWeight="Bold" Margin="0,8,0,0" />
			<Button x:Name="PulsanteCreaIFiction" HorizontalAlignment="Left" Content="{x:Static r:Testi.Gioco_CreaIFiction}"
			        IsVisible="{Binding IFiction, Converter={x:Static ObjectConverters.IsNull}}"
			        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CreaIFictionCommand}" />
			<ContentControl x:Name="CampiIFiction" Content="{Binding IFiction}"
			                IsVisible="{Binding IFiction, Converter={x:Static ObjectConverters.IsNotNull}}">
				<ContentControl.ContentTemplate>
					<DataTemplate x:DataType="vm:IFictionViewModel">
						<Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
							<Grid.Styles>
								<Style Selector="TextBlock.etichetta"><Setter Property="VerticalAlignment" Value="Center" /></Style>
								<Style Selector="TextBox, NumericUpDown"><Setter Property="Margin" Value="0,2" /></Style>
							</Grid.Styles>
							<TextBlock Classes="etichetta" Grid.Row="0" Text="{x:Static r:Testi.Gioco_Titolo}" />
							<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Titolo, Mode=TwoWay}" />
							<TextBlock Classes="etichetta" Grid.Row="1" Text="{x:Static r:Testi.Gioco_Autore}" />
							<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Autore, Mode=TwoWay}" />
							<TextBlock Classes="etichetta" Grid.Row="2" Text="{x:Static r:Testi.Gioco_Ifid}" />
							<DockPanel Grid.Row="2" Grid.Column="1">
								<Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="{x:Static r:Testi.Gioco_GeneraIfid}"
								        Command="{Binding GeneraIfidCommand}" />
								<TextBox Text="{Binding Ifid, Mode=TwoWay}" />
							</DockPanel>
							<TextBlock Classes="etichetta" Grid.Row="3" Text="{x:Static r:Testi.Gioco_Sottotitolo}" />
							<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Sottotitolo, Mode=TwoWay}" />
							<TextBlock Classes="etichetta" Grid.Row="4" Text="{x:Static r:Testi.Gioco_Genere}" />
							<TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Genere, Mode=TwoWay}" />
							<TextBlock Classes="etichetta" Grid.Row="5" Text="{x:Static r:Testi.Gioco_PrimaPubblicazione}" />
							<NumericUpDown Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Width="140"
							               Minimum="0" Increment="1" FormatString="0" ParsingNumberStyle="Integer"
							               Value="{Binding PrimaPubblicazione, Mode=TwoWay, Converter={x:Static v:ConvertitoriGioco.IntFacoltativo}}" />
							<TextBlock Classes="etichetta" Grid.Row="6" Text="{x:Static r:Testi.Gioco_Versione}" />
							<NumericUpDown Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Width="140"
							               Minimum="0" Increment="1" FormatString="0" ParsingNumberStyle="Integer"
							               Value="{Binding Versione, Mode=TwoWay, Converter={x:Static v:ConvertitoriGioco.IntFacoltativo}}" />
							<TextBlock Classes="etichetta" Grid.Row="7" Text="{x:Static r:Testi.Gioco_Descrizione}" VerticalAlignment="Top" Margin="0,8,0,0" />
							<TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Descrizione, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
							<TextBlock Classes="etichetta" Grid.Row="8" Text="{x:Static r:Testi.Gioco_Lingua}" />
							<TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Lingua, Mode=TwoWay}" />
							<TextBlock Classes="etichetta" Grid.Row="9" Text="{x:Static r:Testi.Gioco_Url}" />
							<TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Url, Mode=TwoWay}" />
							<TextBlock Classes="etichetta" Grid.Row="10" Text="{x:Static r:Testi.Gioco_Email}" />
							<TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Email, Mode=TwoWay}" />
						</Grid>
					</DataTemplate>
				</ContentControl.ContentTemplate>
			</ContentControl>
		</StackPanel>
	</ScrollViewer>
</UserControl>
