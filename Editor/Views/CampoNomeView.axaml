<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Casasoft.IFBuilder64.Editor.ViewModels"
             x:Class="Casasoft.IFBuilder64.Editor.Views.CampoNomeView"
             x:DataType="vm:CampoNomeViewModel">
	<UserControl.Styles>
		<Style Selector="TextBox.errore">
			<Setter Property="BorderBrush" Value="Red" />
			<Setter Property="BorderThickness" Value="2" />
		</Style>
	</UserControl.Styles>
	<!-- Invio e perdita del focus confermano, Esc annulla; con un errore bordo rosso e messaggio sotto -->
	<StackPanel Spacing="2">
		<TextBox x:Name="Campo" Text="{Binding Testo, Mode=TwoWay}"
		         Classes.errore="{Binding Errore, Converter={x:Static ObjectConverters.IsNotNull}}"
		         KeyDown="Campo_KeyDown" LostFocus="Campo_LostFocus" />
		<TextBlock Text="{Binding Errore}" Foreground="Red" TextWrapping="Wrap"
		           IsVisible="{Binding Errore, Converter={x:Static ObjectConverters.IsNotNull}}" />
	</StackPanel>
</UserControl>
