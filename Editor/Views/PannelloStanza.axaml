<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Casasoft.IFBuilder64.Editor.ViewModels"
             xmlns:v="using:Casasoft.IFBuilder64.Editor.Views"
             xmlns:r="using:Casasoft.IFBuilder64.Editor.Risorse"
             x:Class="Casasoft.IFBuilder64.Editor.Views.PannelloStanza"
             x:DataType="vm:PannelloStanzaViewModel">
	<ScrollViewer>
		<StackPanel Spacing="6">
			<TextBlock Text="{x:Static r:Testi.Campo_Nome}" FontWeight="SemiBold" />
			<v:CampoNomeView x:Name="CampoNome" DataContext="{Binding Nome}" />
			<TextBlock Text="{x:Static r:Testi.Campo_Descrizione}" FontWeight="SemiBold" />
			<TextBox x:Name="Descrizione" Text="{Binding Stanza.Descrizione, Mode=TwoWay}"
			         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
			<Button x:Name="PulsanteIniziale" Content="{x:Static r:Testi.Stanza_Iniziale}"
			        Command="{Binding ImpostaInizialeCommand}" />

			<TextBlock Text="{x:Static r:Testi.Stanza_Uscite}" FontWeight="SemiBold" Margin="0,6,0,0" />
			<ItemsControl x:Name="ListaUscite" ItemsSource="{Binding Uscite}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:UscitaPannello">
						<Button Content="{Binding Testo}" Command="{Binding Seleziona}"
						        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<TextBlock Text="{x:Static r:Testi.Stanza_Statici}" FontWeight="SemiBold" Margin="0,6,0,0" />
			<ListBox x:Name="ListaStatici" ItemsSource="{Binding Statici}" MaxHeight="120">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:OggettoViewModel">
						<TextBlock Text="{Binding Nome}" />
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<TextBlock Text="{x:Static r:Testi.Stanza_Mobili}" FontWeight="SemiBold" />
			<ListBox x:Name="ListaMobili" ItemsSource="{Binding Mobili}" MaxHeight="120">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:OggettoViewModel">
						<TextBlock Text="{Binding Nome}" />
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Content="{x:Static r:Testi.Stanza_NuovoOggetto}" Command="{Binding NuovoOggettoQuiCommand}" />
				<Button Content="{x:Static r:Testi.Stanza_SpostaQui}" Command="{Binding SpostaQuiCommand}" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
